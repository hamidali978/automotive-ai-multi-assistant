# ---- App ----
APP_ENV=development
CORS_ORIGINS=http://localhost:3000

# ---- Postgres 16 (local install, no Docker) ----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/autoagent

# ---- Zoho CRM ----  (ZOHO_MODE=mock needs no credentials)
ZOHO_MODE=mock
# India data centre shown; use .com / .eu / .com.au etc. to match your Zoho account
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_DOMAIN=https://www.zohoapis.in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_TIMEOUT_S=10
ZOHO_MAX_RETRIES=3
ZOHO_RETRY_BASE_S=0.5
ZOHO_LEAD_SOURCE=Web Research
ZOHO_CASES_MODULE=Cases

# ---- LLM (keys + model names come only from env) ----
LLM_PRIMARY=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Agent / queue tuning ----
MAX_TOOL_ROUNDS=6
HISTORY_MESSAGES=24
QUEUE_POLL_S=20
QUEUE_MAX_ATTEMPTS=8
